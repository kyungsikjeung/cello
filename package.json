{
  "name": "ongyeol-cello-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "api:dev": "node --watch --env-file-if-exists=server/.env.runtime.local server/index.js",
    "api:start": "node --env-file-if-exists=server/.env.runtime server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:backend": "npm run test:backend:unit",
    "test:backend:unit": "vitest run --config tests/backend/vitest.unit.config.js",
    "test:backend:integration": "vitest run --config tests/backend/vitest.integration.config.js",
    "db:migrate": "node --env-file-if-exists=server/.env.admin.local server/scripts/migrate.js",
    "db:provision": "node --env-file-if-exists=server/.env.admin.local server/scripts/provision.js",
    "db:setup": "npm run db:migrate && npm run db:provision",
    "legacy:supabase:start": "supabase start",
    "legacy:supabase:stop": "supabase stop",
    "legacy:supabase:status": "supabase status",
    "legacy:supabase:reset": "supabase db reset",
    "legacy:supabase:lint": "supabase db lint"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@vitejs/plugin-react": "latest",
    "better-auth": "^1.6.25",
    "fastify": "^5.11.0",
    "heic2any": "^0.0.4",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "supabase": "2.111.0",
    "vitest": "^4.1.10"
  }
}
