# 프런트엔드는 전환 기간 동안 Local CMS를 기본값으로 유지합니다.
VITE_STORAGE_MODE=local
VITE_BACKEND_MODE=browser-local
VITE_API_BASE_URL=http://127.0.0.1:4320

# 자체 API 서버. DATABASE_URL과 BETTER_AUTH_SECRET은 브라우저에 노출하면 안 됩니다.
API_HOST=127.0.0.1
API_PORT=4320
CLIENT_ORIGIN=http://127.0.0.1:4318
DATABASE_URL=postgresql://app_runtime:change-runtime-password@127.0.0.1:5432/site_builder
AUTH_DATABASE_URL=postgresql://app_auth_runtime:change-auth-password@127.0.0.1:5432/site_builder
# migration URL은 db:migrate와 db:provision에만 사용하고 API 프로세스에 주입하지 않습니다.
DATABASE_MIGRATION_URL=postgresql://postgres:change-me@127.0.0.1:5432/site_builder
DATABASE_RUNTIME_ROLE=app_runtime
BETTER_AUTH_URL=http://127.0.0.1:4320
BETTER_AUTH_SECRET=
# 역방향 프록시를 실제로 사용할 때만 정확한 IP/CIDR을 쉼표로 구분합니다.
AUTH_TRUSTED_PROXIES=

# R2는 미디어 MVP 이후 선택 사항입니다.
# 아래 값은 서버/Worker 전용입니다. VITE_ 접두사를 붙이거나 브라우저 코드에 노출하지 마세요.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
