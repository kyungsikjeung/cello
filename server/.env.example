# 자체 API 서버. 이 파일의 실제 값은 브라우저와 Git에 노출하지 않습니다.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4320
CLIENT_ORIGIN=http://127.0.0.1:4318

DATABASE_URL=postgresql://app_runtime:change-runtime-password@127.0.0.1:5432/site_builder
AUTH_DATABASE_URL=postgresql://app_auth_runtime:change-auth-password@127.0.0.1:5432/site_builder
# 관리자 URL은 db:migrate와 db:provision에서만 사용하고 운영 API 프로세스에는 주입하지 않습니다.
DATABASE_MIGRATION_URL=postgresql://postgres:change-me@127.0.0.1:5432/site_builder
DATABASE_RUNTIME_ROLE=app_runtime

BETTER_AUTH_URL=http://127.0.0.1:4320
BETTER_AUTH_SECRET=
# 역방향 프록시를 실제로 사용할 때만 정확한 IP 또는 CIDR을 쉼표로 구분합니다.
AUTH_TRUSTED_PROXIES=

# R2는 미디어 MVP 이후 선택 사항입니다.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
