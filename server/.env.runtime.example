# API runtime 전용입니다. 관리자·migration DB URL을 넣지 않습니다.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4320
CLIENT_ORIGIN=http://127.0.0.1:4318

DATABASE_URL=postgresql://app_runtime:change-runtime-password@127.0.0.1:5432/site_builder
AUTH_DATABASE_URL=postgresql://app_auth_runtime:change-auth-password@127.0.0.1:5432/site_builder

BETTER_AUTH_URL=http://127.0.0.1:4320
BETTER_AUTH_SECRET=
# 역방향 프록시를 실제로 사용할 때만 정확한 IP 또는 CIDR을 쉼표로 구분합니다.
AUTH_TRUSTED_PROXIES=

# R2는 미디어 MVP 이후 선택 사항입니다.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
